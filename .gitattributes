* text=auto eol=lf

# Unity YAML — never let git mangle these
*.unity   -text merge=unityyamlmerge diff
*.prefab  -text merge=unityyamlmerge diff
*.asset   -text merge=unityyamlmerge diff
*.mat     -text merge=unityyamlmerge diff
*.meta    -text merge=unityyamlmerge diff
*.controller -text merge=unityyamlmerge diff

# Generated CSV is committed. Keep bytes stable.
Assets/CocClear/Data/Generated/*.csv text eol=lf

*.xlsx binary
*.png  binary
*.jpg  binary
*.fbx  binary
*.wav  binary
*.ogg  binary
*.ttf  binary
*.otf  binary
